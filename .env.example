# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- KEAGROW admin backend ---
# Password required to log into /admin. Change this before going live.
ADMIN_PASSWORD="change-me"
# Random secret used to sign admin session tokens. Change this too.
ADMIN_TOKEN_SECRET="change-this-to-a-long-random-string"
# Port the Express server (server/index.js) listens on.
PORT=4000

# MongoDB Atlas connection string.
# Atlas dashboard → Database → Connect → Drivers → copy the string,
# then swap in your DB user's username/password and a database name.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/keagrow?retryWrites=true&w=majority"

# --- Email (for the "Confirm & Email" button in admin -> Inquiries) ---
# Works with Gmail: use smtp.gmail.com, port 587, your Gmail address,
# and a 16-character "App Password" (Google Account -> Security ->
# App Passwords) -- NOT your normal Gmail password, Gmail blocks that
# for SMTP. Any other SMTP provider (Zoho, Outlook, etc.) works too.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="youraddress@gmail.com"
SMTP_PASS="your-16-char-app-password"
# Optional -- defaults to SMTP_USER if not set.
FROM_EMAIL="youraddress@gmail.com"
